  "info": {
    "_postman_id": "f0e01b60-c289-4482-bb43-8dd2a950d146",
    "name": "CleverTap REST Campaigns Profiles API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "CleverTap customer engagement and retention REST API.\nThe base URL is region-specific: replace {region} with your account's\nregion code (e.g. in1, us1, eu1, sg1, sk1, mec1). All requests must\ninclude X-CleverTap-Account-Id and X-CleverTap-Passcode headers.\nRate limits: concurrent requests capped at 15 per account; campaign\ncreation limited to 3 RPS.\n\n\nContact Support:\n Name: CleverTap Developers",
      "type": "text/plain"
    }
  }
